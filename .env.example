# DATABASE_URL="mysql://root:password@localhost:3306/evokasir_db"
DATABASE_URL="mysql://root@localhost:3306/evokasir"
# NEXT_PUBLIC_BASE_URL=https://ekasir.evognito.my.id

MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=SB-Mid-server-XXXXXXXXXXX
MIDTRANS_CLIENT_KEY=SB-Mid-client-XXXXXXXXXXX
MIDTRANS_QRIS_EXPIRY_MINUTES=15

MOBILE_ACCESS_TOKEN_SECRET=
MOBILE_REFRESH_TOKEN_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

SMTP_FROM_NAME=Evokasir
SMTP_FROM_EMAIL=your-email@gmail.com

EMAIL_REPLY_TO=your-email@gmail.com

# ==============================
# KALOO IoT Gateway
# ==============================
IOT_PORT=3010
IOT_HOST=0.0.0.0

# Next.js app yang menjadi source-of-truth snapshot.
NEXT_INTERNAL_BASE_URL=http://127.0.0.1:3000

# WAJIB sama di Next.js dan iot-server.
# Gunakan string random panjang minimal 32 byte.
IOT_INTERNAL_SECRET=GANTI_DENGAN_SECRET_RANDOM_PANJANG

# Phase 1: shared token untuk prototype ESP32.
# Nanti diganti token per-device melalui iot_devices.
IOT_DEVICE_TOKEN=GANTI_DENGAN_DEVICE_TOKEN_RANDOM

# Helper Next.js akan memakai ini.
IOT_GATEWAY_URL=http://127.0.0.1:3010
