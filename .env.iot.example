# ==============================
# KALOO IoT Gateway
# ==============================
IOT_PORT=3010
IOT_HOST=0.0.0.0

# Next.js app yang menjadi source-of-truth snapshot.
NEXT_INTERNAL_BASE_URL=http://127.0.0.1:3000

# WAJIB sama di Next.js dan iot-server.
# Gunakan string random panjang minimal 32 byte.
IOT_INTERNAL_SECRET=GANTI_DENGAN_SECRET_RANDOM_PANJANG

# Phase 1: shared token untuk prototype ESP32.
# Nanti diganti token per-device melalui iot_devices.
IOT_DEVICE_TOKEN=GANTI_DENGAN_DEVICE_TOKEN_RANDOM

# Helper Next.js akan memakai ini.
IOT_GATEWAY_URL=http://127.0.0.1:3010
